{
	"tokenColors": [
		{
			"name": "RED",
			"scope": [
				"constant.numeric",
				"constant.language",
				"punctuation.section.block",
				"keyword.other.unit.hexadecimal",
				"entity.other.attribute-name.pragma.preprocessor"


				// python
				// ---

			],
			"settings": {
				"foreground": "#AC5A42"
			}
		},
		{
			"name": "REDish",
			"scope": [
				"entity.other.attribute.nodiscard",
				"entity.other.attribute.maybe_unused",
				"keyword.other.requires"

				// python
				// ---

			],
			"settings": {
				"foreground": "#995B66",
				"fontStyle": "bold"
			}
		},
		{
			"name": "GOLD",
			"scope": [
				"storage.type.built-in",
				"storage.type.built-in.primitive",
